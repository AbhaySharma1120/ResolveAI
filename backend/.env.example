PORT=5000
NODE_ENV=development

FRONTEND_URL=http://localhost:5173

MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/resolveai

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

OFFICER_EMAIL=officer@example.com
OFFICER_PASSWORD=replace_with_secure_password

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_secure_password

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_google_app_password